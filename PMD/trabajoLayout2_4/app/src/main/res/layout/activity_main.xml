<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tituloFormulario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textSize="20sp"
            android:text="@string/tituloFormulario" />

        <EditText
            android:id="@+id/inputNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:backgroundTint="@color/cian"
            android:hint="@string/placeholdNombre"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/inputCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:backgroundTint="@color/cian"
            android:hint="@string/placeholdCorreo"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/inputContraseña"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:backgroundTint="@color/cian"
            android:hint="@string/placeholdContraseña"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/inputConfirmarContraseña"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:backgroundTint="@color/cian"
            android:hint="@string/placeholdConfirmarContraseña"
            android:inputType="textPassword" />

        <TextView
            android:layout_marginTop="20dp"
            android:id="@+id/labelSexo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textSize="20sp"
            android:text="@string/sexo" />

        <RadioGroup
            android:id="@+id/input_genero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/opcionHombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionHombre" />

            <RadioButton
                android:id="@+id/opcionMujer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionMujer" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/input_terminos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terminosCondiciones" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botonRegistro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#00FFB6"
                android:text="@string/botonRegistro"
                android:textColor="#000000" />

            <Button
                android:id="@+id/botonModoOscuro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/black"
                android:text="@string/BotonModoOscuro" />

        </LinearLayout>

        <TextView
            android:id="@+id/pieFormulario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/pieFormulario"
            android:textStyle="bold"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>