# ========================================================
# Variables de Entorno - Odoo & PostgreSQL
# Copia este archivo como .env y edita los valores
# ========================================================

# Versiones de las imágenes Docker (usar versiones ligeras o estables)
ODOO_IMAGE_TAG=17.0
POSTGRES_IMAGE_TAG=16-alpine

# Credenciales y Configuración de PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_secure_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optimización de Rendimiento PostgreSQL (Ajustar según RAM disponible)
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=16MB

# Odoo - Contraseña maestra para gestión de bases de datos
ODOO_ADMIN_PASSWORD=super_admin_master_pwd_change_me

# Puertos expuestos al host
ODOO_HTTP_PORT=8069
ODOO_CHAT_PORT=8072

# Límites de Recursos para Contenedores (Docker Resource Limits)
ODOO_CPU_LIMIT=2.0
ODOO_MEMORY_LIMIT=2048M
DB_CPU_LIMIT=1.5
DB_MEMORY_LIMIT=1024M
